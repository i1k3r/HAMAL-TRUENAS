# HAMAL configuration. Copy to .env and adjust for your deployment.
# Note: Variables prefixed with HAMAL_* are preferred; legacy LAN_DROP_* are supported as fallback.
HAMAL_LISTEN_ADDR=:7700
# Set this to the URL users will scan or open (e.g. http://192.168.1.100:7700 or https://hamal.local)
# HAMAL_BASE_URL=http://192.168.1.100:7700
HAMAL_DATA_DIR=/data
HAMAL_DB_PATH=/data/hamal.db
# Supply a 32+ byte random string, or omit to auto-generate and persist in /data/secrets/server-secret.
# HAMAL_SERVER_SECRET=
HAMAL_MAX_TTL=24h
HAMAL_DEFAULT_TTL=1h
HAMAL_MIN_TTL=5m
HAMAL_MAX_FILE_SIZE=10GiB
HAMAL_MAX_ROOM_SIZE=10GiB
HAMAL_MAX_FILES_PER_ROOM=100
HAMAL_MAX_TOTAL_STORAGE=100GiB
HAMAL_MIN_FREE_SPACE=5GiB
HAMAL_CLEANUP_INTERVAL=1m
HAMAL_UPLOAD_IDLE_TIMEOUT=10m
HAMAL_LOG_FORMAT=json
HAMAL_LOG_LEVEL=info
# HAMAL_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
HAMAL_SECURE_COOKIES=auto
